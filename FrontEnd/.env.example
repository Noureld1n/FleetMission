# Relative path keeps REST and SSE same-origin through the Vite proxy.
VITE_API_BASE_URL=/api

# Empty derives ws:// or wss:// from the current page origin.
VITE_WS_URL=

# Set the vector style URL selected for the map deployment.
VITE_MAP_STYLE_URL=

# Development-server targets only; these are not exposed to browser code.
BACKEND_PROXY_TARGET=http://localhost:8080
MANAGEMENT_PROXY_TARGET=http://127.0.0.1:8081
